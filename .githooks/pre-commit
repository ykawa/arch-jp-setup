#!/bin/bash
# コミット前にシェルスクリプトを整形し、PC 固有の情報（ユーザー名・絶対パスなど）が入っていないか検査する
# 有効化: git config core.hooksPath .githooks（scripts/tools/writeback.sh が設定する）
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

mapfile -d '' files < <(git diff --cached --name-only --diff-filter=ACMR -z)
[ ${#files[@]} -gt 0 ] || exit 0

# ステージしたファイルを整形してステージし直す。shfmt がなければ CI の検査に任せる
if command -v shfmt &>/dev/null; then
    for file in "${files[@]}"; do
        case "$file" in
            *.sh | .githooks/pre-commit) ;;
            *) continue ;;
        esac
        [ ! -L "$file" ] || continue

        # 未ステージの変更があるファイルは、ステージし直すと変更が混ざるので検査だけにする
        if ! git diff --quiet -- "$file"; then
            if ! shfmt -d "$file"; then
                echo "pre-commit: 未ステージの変更があるため整形できません: $file" >&2
                echo "shfmt -w で整形してステージし直してください" >&2
                exit 1
            fi
            continue
        fi

        shfmt -w "$file"
        git add -- "$file"
    done
else
    echo "pre-commit: shfmt がないため整形をスキップします" >&2
fi

bash "$REPO_ROOT/scripts/tools/check-private.sh" --staged "${files[@]}"
