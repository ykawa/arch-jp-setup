// ────────────── Output Configuration ──────────────
// Run `niri msg outputs` to get the correct output name.
// https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs

/-output "eDP-1" {
    mode "1920x1080@120.030"
    scale 2
    transform "normal"
    position x=1280 y=0
}

output "Virtual-1" {
    mode "1920x1080@60.0"
    scale 1.0
}
